def format_axis_label(axis: str) -> str:
    return AXIS_LABELS.get(axis, axis.replace("_", " ").title())


def axis_label_for_column(column: str) -> str:
    base = column
    for suffix in ("_mean", "_std"):
        if column.endswith(suffix):
            base = column[: -len(suffix)]
            break
    return format_axis_label(base)


def resolve_plot_column(df: pd.DataFrame, axis: str) -> Optional[str]:
    if axis in df.columns:
        return axis
    mean_axis = f"{axis}_mean"
    if mean_axis in df.columns:
        return mean_axis
    return None


def blend_with_white(base_rgb: Tuple[int, int, int], weight: float) -> str:
    clamped = max(0.0, min(1.0, weight))
    red = int(255 * (1 - clamped) + base_rgb[0] * clamped)
    green = int(255 * (1 - clamped) + base_rgb[1] * clamped)
    blue = int(255 * (1 - clamped) + base_rgb[2] * clamped)
    return f"rgb({red},{green},{blue})"


def apply_dual_color_intensity(
    fig: go.Figure,
    df: pd.DataFrame,
    base_column: str,
    intensity_column: str,
) -> Optional[Tuple[float, float]]:
    palette = px.colors.qualitative.Plotly
    base_values = [str(value) for value in df[base_column].dropna().unique()]
    color_map = {
        value: palette[index % len(palette)]
        for index, value in enumerate(base_values)
    }
    intensity_values = df[intensity_column].to_numpy()
    intensity_values = intensity_values[np.isfinite(intensity_values)]
    if intensity_values.size == 0:
        return None
    min_intensity = float(np.nanmin(intensity_values))
    max_intensity = float(np.nanmax(intensity_values))
    intensity_range = max_intensity - min_intensity
    for trace in fig.data:
        if trace.name is None:
            continue
        base_name = str(trace.name)
        base_color = color_map.get(base_name, palette[0])
        base_rgb = hex_to_rgb(base_color)
        trace_df = df[df[base_column].astype(str) == base_name]
        values = trace_df[intensity_column].to_numpy()
        if intensity_range <= 0:
            weights = np.full_like(values, 0.6, dtype=float)
        else:
            weights = 0.2 + 0.8 * ((values - min_intensity) / intensity_range)
        colors = [blend_with_white(base_rgb, weight) for weight in weights]
        marker = trace.marker.to_plotly_json() if trace.marker else {}
        marker["color"] = colors
        trace.marker = marker
    return min_intensity, max_intensity


def add_intensity_colorbar(
    fig: go.Figure,
    label: str,
    min_intensity: float,
    max_intensity: float,
    font_size: int,
) -> None:
    if not np.isfinite(min_intensity) or not np.isfinite(max_intensity):
        return
    if min_intensity == max_intensity:
        span = abs(min_intensity) if min_intensity != 0 else 1.0
        min_intensity -= span * 0.01
        max_intensity += span * 0.01
    fig.add_trace(
        go.Scatter(
            x=[None],
            y=[None],
            mode="markers",
            showlegend=False,
            hoverinfo="skip",
            marker={
                "colorscale": "Greys",
                "cmin": min_intensity,
                "cmax": max_intensity,
                "color": [min_intensity, max_intensity],
                "showscale": True,
                "colorbar": {
                    "title": {"text": label, "font": {"size": font_size}},
                    "tickfont": {"size": font_size},
                },
            },
        )
    )


def apply_plot_style(fig: go.Figure, font_size: int) -> None:
    fig.update_layout(
