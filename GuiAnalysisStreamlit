def filter_dataframe(df: pd.DataFrame, selections: Dict[str, List[str]]) -> pd.DataFrame:
    filtered = df.copy()
    for key, values in selections.items():
        if values:
            filtered = filtered[filtered[key].isin(values)]
    return filtered


def tls_term(temperature: np.ndarray, n_ph: np.ndarray, fr_hz: np.ndarray, delta_tls: float, n_c: float, alpha: float) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    return delta_tls * (1.0 + n_ph / n_c) ** alpha * np.tanh(scaled)


def qp_term(temperature: np.ndarray, fr_hz: np.ndarray, q_qp0: float, delta: float) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    scaled = np.clip(scaled, 1e-6, 1e3)
    exponent = np.clip(-delta / (LOSS_BOLTZMANN * temperature), -700, 700)
    return (1.0 / q_qp0) * np.exp(exponent) * np.sinh(scaled) * k0(scaled)


def to_hz(frequency: np.ndarray) -> np.ndarray:
    if np.nanmax(frequency) < 1e6:
        return frequency * 1e9
    return frequency


def model_inv_q(
    temperature: np.ndarray,
    n_ph: np.ndarray,
    fr_hz: np.ndarray,
    params: Dict[str, float],
    fit_mode: str,
    alpha: float,
) -> Dict[str, np.ndarray]:
    inv_q_other = np.full_like(temperature, 1.0 / params["Qother"])
    inv_q_tls1 = np.zeros_like(temperature)
    inv_q_tls2 = np.zeros_like(temperature)
    inv_q_qp = np.zeros_like(temperature)

    if "QTLS" in fit_mode:
        inv_q_tls1 = tls_term(
            temperature,
            n_ph,
            fr_hz,
            params["delta_tls1_0"],
            params["n_c1"],
            alpha,
        )
    if "QTLS2" in fit_mode:
        inv_q_tls2 = tls_term(
            temperature,
            n_ph,
            fr_hz,
            params["delta_tls2_0"],
            params["n_c2"],
            alpha,
        )
    if "Qqp" in fit_mode:
        inv_q_qp = qp_term(
            temperature,
            fr_hz,
            params["Q_qp0"],
            params["Delta"],
        )

    inv_q_total = inv_q_other + inv_q_tls1 + inv_q_tls2 + inv_q_qp
    return {
        "inv_q_total": inv_q_total,
        "inv_q_other": inv_q_other,
        "inv_q_tls1": inv_q_tls1,
        "inv_q_tls2": inv_q_tls2,
        "inv_q_qp": inv_q_qp,
    }


def build_param_template(fit_mode: str, alpha_fit: bool, delta_fit: bool, tc_kelvin: float) -> Tuple[List[str], Dict[str, float]]:
    names = ["Qother"]
    defaults = {
        "Qother": 1e6,
        "delta_tls1_0": 1e-6,
        "n_c1": 1.0,
        "delta_tls2_0": 1e-6,
        "n_c2": 1.0,
        "Q_qp0": 1e6,
        "Delta": 1.76 * LOSS_BOLTZMANN * tc_kelvin,
        "alpha": 0.5,
    }
    if "QTLS" in fit_mode:
        names.extend(["delta_tls1_0", "n_c1"])
    if "QTLS2" in fit_mode:
        names.extend(["delta_tls2_0", "n_c2"])
    if "Qqp" in fit_mode:
        names.append("Q_qp0")
        if delta_fit:
            names.append("Delta")
    if alpha_fit and "QTLS" in fit_mode:
        names.append("alpha")
    return names, defaults


def fit_inv_q(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    random_starts: int = 1,
    loss: str = "linear",
    f_scale: float = 1.0,
    seed: Optional[int] = None,
) -> Tuple[Dict[str, float], Dict[str, np.ndarray]]:
    temperature = df["temperature"].to_numpy()
    fr_hz = to_hz(df["fr"].to_numpy())
    q_meas = df["Qi"].to_numpy()
    n_ph = 10.0 ** (df["power_dbm"].to_numpy() / 10.0)
    inv_q = 1.0 / q_meas
    q_err = df["Qi_err"].to_numpy() if "Qi_err" in df.columns else None
    inv_q_err = None if q_err is None else (q_err / (q_meas**2))

    param_names, defaults = build_param_template(fit_mode, alpha_fit, delta_fit, tc_kelvin)
    if np.isfinite(q_meas).any():
        defaults["Qother"] = float(np.nanmax(q_meas))
    if np.isfinite(q_meas).any():
        defaults["Q_qp0"] = max(defaults.get("Q_qp0", 1e6), float(np.nanmax(q_meas)))
    initial = np.array([defaults[name] for name in param_names], dtype=float)
    lower_bounds = {
        "Qother": 1.0,
        "delta_tls1_0": 0.0,
        "n_c1": 1e-12,
        "delta_tls2_0": 0.0,
        "n_c2": 1e-12,
        "Q_qp0": 1.0,
        "Delta": 0.0,
        "alpha": 0.0,
    }
    upper_bounds = {
        "Qother": np.inf,
        "delta_tls1_0": np.inf,
        "n_c1": np.inf,
        "delta_tls2_0": np.inf,
        "n_c2": np.inf,
        "Q_qp0": np.inf,
        "Delta": np.inf,
        "alpha": 2.0,
    }
    if bounds_override:
        for key, (lower_value, upper_value) in bounds_override.items():
            if key in lower_bounds:
                lower_bounds[key] = lower_value
            if key in upper_bounds:
                upper_bounds[key] = upper_value
    lower = np.array([lower_bounds[name] for name in param_names], dtype=float)
    upper = np.array([upper_bounds[name] for name in param_names], dtype=float)

    def residuals(param_values: np.ndarray) -> np.ndarray:
        params = defaults.copy()
        params.update(dict(zip(param_names, param_values)))
        alpha = params.get("alpha", defaults["alpha"])
        model = model_inv_q(temperature, n_ph, fr_hz, params, fit_mode, alpha)["inv_q_total"]
        resid = model - inv_q
        if inv_q_err is not None and np.all(inv_q_err > 0):
            resid = resid / inv_q_err
        return resid

    rng = np.random.default_rng(seed)
    n_starts = max(int(random_starts), 1)
    best_result = None
    for attempt in range(n_starts):
        if attempt == 0:
            start = initial
        else:
            start = initial.copy()
            for idx, name in enumerate(param_names):
                low = lower[idx]
                high = upper[idx]
                if not np.isfinite(low):
                    low = 0.0
                if not np.isfinite(high):
                    high = max(low + 1.0, defaults[name] * 10.0)
                if high <= low:
                    start[idx] = low
                elif low > 0 and high > 0:
                    start[idx] = float(np.exp(rng.uniform(np.log(low), np.log(high))))
                else:
                    start[idx] = float(rng.uniform(low, high))
        result = least_squares(
            residuals,
            start,
            bounds=(lower, upper),
            max_nfev=20000,
            loss=loss,
            f_scale=f_scale,
        )
        if best_result is None or result.cost < best_result.cost:
            best_result = result
    fitted = defaults.copy()
    fitted.update(dict(zip(param_names, best_result.x)))
    alpha_val = fitted.get("alpha", defaults["alpha"])
    components = model_inv_q(temperature, n_ph, fr_hz, fitted, fit_mode, alpha_val)
    return fitted, components


def mb_sigma_ratio(temperature: np.ndarray, tc: float) -> np.ndarray:
    t_ratio = np.clip(temperature / tc, 1e-6, 0.9999)
    return 1.0 / np.sqrt(1.0 - t_ratio**4)


def tls_dispersion_term(temperature: np.ndarray, f0_hz: float, f_tls: float) -> np.ndarray:
    arg = 0.5 + (PLANCK * f0_hz) / (2.0 * np.pi * 1j * LOSS_BOLTZMANN * temperature)
    psi = digamma(arg)
    real_part = np.real(psi)
    log_term = np.log((PLANCK * f0_hz) / (LOSS_BOLTZMANN * temperature))
    return (f_tls / np.pi) * (real_part - log_term)


def kinetic_shift_model(
    temperature: np.ndarray,
    f0_hz: float,
    alpha: float,
    tc: float,
    f_tls: float,
    mode: str,
) -> np.ndarray:
    mb_term = -0.5 * alpha * (mb_sigma_ratio(temperature, tc) - 1.0)
    tls_term = tls_dispersion_term(temperature, f0_hz, f_tls)
    if mode == "MB":
        return f0_hz * (1.0 + mb_term)
    if mode == "TLS":
        return f0_hz * (1.0 + tls_term)
    return f0_hz * (1.0 + mb_term + tls_term)


def fit_kinetic(
    df: pd.DataFrame,
    tc_kelvin: float,
    alpha_init: float,
    mode: str,
    f_tls_init: float,
) -> Tuple[np.ndarray, np.ndarray]:
    temperature = df["temperature"].to_numpy()
    fr_hz = df["fr"].to_numpy()
    initial = [fr_hz.max(), alpha_init, tc_kelvin, f_tls_init]

    def model(temp: np.ndarray, f0: float, alpha: float, tc: float, f_tls: float) -> np.ndarray:
        return kinetic_shift_model(temp, f0, alpha, tc, f_tls, mode)

    lower = [0.0, 0.0, max(temperature.min() * 0.5, 0.1), -1.0]
    upper = [np.inf, 5.0, max(temperature.max() * 5.0, tc_kelvin * 5.0), 1.0]

    if mode == "MB":
        initial = [fr_hz.max(), alpha_init, tc_kelvin]
        lower = [0.0, 0.0, max(temperature.min() * 0.5, 0.1)]
        upper = [np.inf, 5.0, max(temperature.max() * 5.0, tc_kelvin * 5.0)]

        def model(temp: np.ndarray, f0: float, alpha: float, tc: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, alpha, tc, 0.0, "MB")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    if mode == "TLS":
        initial = [fr_hz.max(), f_tls_init]
        lower = [0.0, -1.0]
        upper = [np.inf, 1.0]

        def model(temp: np.ndarray, f0: float, f_tls: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, 0.0, tc_kelvin, f_tls, "TLS")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
    return params, covariance


