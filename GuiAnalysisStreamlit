def aggregate_by_power(df: pd.DataFrame) -> pd.DataFrame:
    grouped = (
        df.groupby(["experiment", "chip", "temperature", "power_dbm"])
        .agg(
            fr_mean=("fr", "mean"),
            fr_std=("fr", "std"),
            Ql_mean=("Ql", "mean"),
            Ql_std=("Ql", "std"),
            Qc_mean=("Qc", "mean"),
            Qc_std=("Qc", "std"),
            Qi_mean=("Qi", "mean"),
            Qi_std=("Qi", "std"),
            Qi_err_mean=("Qi_err", "mean"),
            count=("resonator", "nunique"),
        )
        .reset_index()
    )
    return grouped


