            continue
        marker = trace.marker.to_plotly_json() if trace.marker else {}
        color_value = marker.get("color")
        if isinstance(color_value, (list, tuple, np.ndarray)):
            continue
        marker["color"] = color_map[trace_name]
        trace.marker = marker
        if hasattr(trace, "line") and trace.line is not None:
            line_json = trace.line.to_plotly_json()
            line_json["color"] = color_map[trace_name]
            trace.line = line_json


def add_intensity_colorbar(
    fig: go.Figure,
    label: str,
    min_intensity: float,
    max_intensity: float,
    font_size: int,
) -> None:
    if not np.isfinite(min_intensity) or not np.isfinite(max_intensity):
        return
    if min_intensity == max_intensity:
        span = abs(min_intensity) if min_intensity != 0 else 1.0
        min_intensity -= span * 0.01
        max_intensity += span * 0.01
    fig.update_coloraxes(colorbar_x=1.02)
    fig.add_trace(
        go.Scatter(
            x=[None],
            y=[None],
            mode="markers",
            showlegend=False,
            hoverinfo="skip",
            marker={
                "colorscale": "Greys",
                "cmin": min_intensity,
                "cmax": max_intensity,
                "color": [min_intensity, max_intensity],
                "showscale": True,
                "colorbar": {
                    "title": {"text": label, "font": {"size": font_size}},
                    "tickfont": {"size": font_size},
                    "x": 1.12,
                    "xanchor": "left",
                },
            },
        )
    )


