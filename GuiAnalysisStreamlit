                    y=grouping_df["fr"] / 1e9,
                    mode="markers",
                    marker=dict(color=grouping_df["group_id"].astype("category").cat.codes),
                    customdata=np.stack([grouping_df["row_id"]], axis=-1),
                    name="Resonators",
                )
            )
            fig_group.update_layout(
                xaxis_title="Temperature (K)",
                yaxis_title="Frequency (GHz)",
                dragmode="lasso",
            )
            apply_plot_style(fig_group, plot_font_size)
            selection = st.plotly_chart(fig_group, use_container_width=True, on_select="rerun")

            if selection and "points" in selection:
                selected_row_ids = [int(point["customdata"][0]) for point in selection["points"]]

            current_groups = sorted(
                {value for value in group_assignments.dropna().unique().tolist() if value}
            )
            group_summary = (
                grouping_df.dropna(subset=["group_id"])
                .groupby("group_id")
                .agg(
                    count=("row_id", "count"),
                    fr_median=("fr", "median"),
                    t_min=("temperature", "min"),
                    t_max=("temperature", "max"),
                )
                .reset_index()
                .sort_values("fr_median")
            )
            if not group_summary.empty:
                group_summary["fr_median_ghz"] = group_summary["fr_median"] / 1e9
                st.dataframe(
                    group_summary[["group_id", "count", "fr_median_ghz", "t_min", "t_max"]],
                    use_container_width=True,
                )

        if grouping_df.empty:
            st.info("Grouping tools are disabled until data is available.")
        else:
            with st.expander("Manual group editing", expanded=True):
                st.write(f"Selected points: {len(selected_row_ids)}")
                col1, col2 = st.columns(2)
                with col1:
                    if st.button("New group from selection", disabled=not selected_row_ids):
                        next_index = 1
                        for group_id in current_groups:
                            if group_id.startswith("G") and group_id[1:].isdigit():
                                next_index = max(next_index, int(group_id[1:]) + 1)
                        new_group_id = f"G{next_index}"
                        for row_id in selected_row_ids:
                            stored_assignments[row_id] = new_group_id
                        st.session_state[grouping_state_key]["assignments"] = stored_assignments
                        st.session_state[grouping_state_key]["source"] = "manual"

                    add_options = current_groups or ["(no groups)"]
                    add_target = st.selectbox("Add selection to group", add_options, disabled=not current_groups)
                    if st.button("Add selection", disabled=not selected_row_ids or not current_groups):
                        for row_id in selected_row_ids:
                            stored_assignments[row_id] = add_target
                        st.session_state[grouping_state_key]["assignments"] = stored_assignments
                        st.session_state[grouping_state_key]["source"] = "manual"

                    if st.button("Remove selection from groups", disabled=not selected_row_ids):
                        for row_id in selected_row_ids:
                            stored_assignments[row_id] = None
                        st.session_state[grouping_state_key]["assignments"] = stored_assignments
                        st.session_state[grouping_state_key]["source"] = "manual"
                with col2:
                    merge_groups = st.multiselect("Merge groups", current_groups)
                    merge_options = merge_groups or ["(select groups)"]
                    merge_target = st.selectbox("Merge target", merge_options, disabled=len(merge_groups) < 2)
                    if st.button("Merge selected groups", disabled=len(merge_groups) < 2):
                        for row_id, group_id in stored_assignments.items():
                            if group_id in merge_groups:
                                stored_assignments[row_id] = merge_target
                        st.session_state[grouping_state_key]["assignments"] = stored_assignments
                        st.session_state[grouping_state_key]["source"] = "manual"

                    if st.button("Split selection into new group", disabled=not selected_row_ids):
                        next_index = 1
                        for group_id in current_groups:
                            if group_id.startswith("G") and group_id[1:].isdigit():
                                next_index = max(next_index, int(group_id[1:]) + 1)
                        new_group_id = f"G{next_index}"
                        for row_id in selected_row_ids:
                            stored_assignments[row_id] = new_group_id
                        st.session_state[grouping_state_key]["assignments"] = stored_assignments
                        st.session_state[grouping_state_key]["source"] = "manual"

            if st.button("Save grouping mapping"):
                grouping_base_df["group_id"] = pd.Series(
                    [stored_assignments.get(row_id) for row_id in grouping_base_df["row_id"]],
                    index=grouping_base_df.index,
                    dtype=object,
                )
                mapping = build_group_mapping(grouping_base_df, grouping_experiment, grouping_chip)
                save_group_mapping(mapping_path, mapping)
                st.success("Grouping mapping saved.")
    else:
        st.info("Select an experiment and chip to manage resonator groups.")

kinetic_df = filtered_df.dropna(subset=["temperature", "fr"]).copy()
if grouping_state_key and grouping_experiment and grouping_chip:
    group_state = st.session_state.get(grouping_state_key, {})
    stored_assignments = group_state.get("assignments", {})
    kinetic_df["group_id"] = [
        stored_assignments.get(row_id) for row_id in kinetic_df["row_id"]
    ]
else:
    kinetic_df["group_id"] = None

kinetic_mode = st.selectbox("Kinetic fit mode", ["MB", "TLS", "MB+TLS"], index=2)
tc_handling = st.radio("Tc handling", ["Fit Tc", "Fix Tc"], horizontal=True)
kinetic_tc = st.number_input("Tc for kinetic fit (K)", min_value=0.1, max_value=20.0, value=1.2, step=0.1)
tc_min = st.number_input("Tc min bound (K)", min_value=0.1, max_value=20.0, value=2.0, step=0.1)
tc_max = st.number_input("Tc max bound (K)", min_value=0.1, max_value=20.0, value=10.0, step=0.1)
alpha_init = st.number_input("Alpha initial", min_value=0.0, max_value=5.0, value=0.1, step=0.05)
f_tls_init = st.number_input("F TLS initial", min_value=-1.0, max_value=1.0, value=0.0, step=0.01)
fit_per_resonator = st.checkbox("Fit per resonator group", value=True)
fit_temp_min = st.number_input("Fit Tmin (K)", min_value=0.0, max_value=20.0, value=0.6, step=0.05)
fit_temp_max = st.number_input("Fit Tmax (K)", min_value=0.0, max_value=20.0, value=1.5, step=0.05)

kinetic_fit_state = st.session_state.get("kinetic_fit_state")
if st.button("Run kinetic fit"):
    if kinetic_df.empty:
        st.warning("No data available for kinetic fit.")
        st.session_state.pop("kinetic_fit_state", None)
        kinetic_fit_state = None
    elif fit_per_resonator:
        results = []
        params_by_resonator = {}
        temp_low, temp_high = sorted((fit_temp_min, fit_temp_max))
        if kinetic_df["group_id"].isna().all():
            st.warning("No resonator groups assigned. Please create groups first.")
            st.session_state.pop("kinetic_fit_state", None)
            kinetic_fit_state = None
        else:
            for group_id, group_df in kinetic_df.dropna(subset=["group_id"]).groupby("group_id"):
                fit_df = group_df[
                    (group_df["temperature"] >= temp_low)
                    & (group_df["temperature"] <= temp_high)
                ]
                if len(fit_df) < 3:
                    continue
                tc_bounds = tuple(sorted((float(tc_min), float(tc_max))))
                try:
                    params, covariance = fit_kinetic(
                        fit_df,
                        kinetic_tc,
                        alpha_init,
                        kinetic_mode,
                        f_tls_init,
                        tc_handling == "Fit Tc",
                        tc_bounds,
                    )
                except RuntimeError:
                    continue
                condition_number = np.linalg.cond(covariance) if covariance is not None and covariance.size else np.nan
                if kinetic_mode == "MB":
                    if tc_handling == "Fit Tc":
                        f0, alpha, tc_fit = params
                    else:
                        f0, alpha = params
                        tc_fit = kinetic_tc
                    results.append(
                        {"group_id": group_id, "f0": f0, "alpha": alpha, "Tc": tc_fit, "cond": condition_number}
                    )
                    params_by_resonator[group_id] = {"f0": f0, "alpha": alpha, "tc": tc_fit, "f_tls": 0.0}
                elif kinetic_mode == "TLS":
                    f0, f_tls = params
                    results.append({"group_id": group_id, "f0": f0, "F_TLS": f_tls, "cond": condition_number})
                    params_by_resonator[group_id] = {"f0": f0, "alpha": 0.0, "tc": kinetic_tc, "f_tls": f_tls}
                else:
                    if tc_handling == "Fit Tc":
                        f0, alpha, tc_fit, f_tls = params
                    else:
                        f0, alpha, f_tls = params
                        tc_fit = kinetic_tc
                    results.append(
                        {
                            "group_id": group_id,
                            "f0": f0,
                            "alpha": alpha,
                            "Tc": tc_fit,
                            "F_TLS": f_tls,
                            "cond": condition_number,
                        }
                    )
                    params_by_resonator[group_id] = {"f0": f0, "alpha": alpha, "tc": tc_fit, "f_tls": f_tls}
        if not results:
            st.warning("No resonators with sufficient data for fitting.")
            st.session_state.pop("kinetic_fit_state", None)
            kinetic_fit_state = None
        else:
            kinetic_fit_state = {
                "fit_per_resonator": True,
                "results_df": pd.DataFrame(results).sort_values("group_id"),
                "params_by_resonator": params_by_resonator,
                "kinetic_mode": kinetic_mode,
                "kinetic_tc": kinetic_tc,
                "tc_handling": tc_handling,
            }
            st.session_state["kinetic_fit_state"] = kinetic_fit_state
    else:
        st.warning("Global fits are disabled. Enable per-resonator group fitting.")
        st.session_state.pop("kinetic_fit_state", None)
        kinetic_fit_state = None

if kinetic_fit_state:
    if kinetic_fit_state["fit_per_resonator"]:
        results_df = kinetic_fit_state["results_df"]
        params_by_resonator = kinetic_fit_state["params_by_resonator"]
        kinetic_mode = kinetic_fit_state["kinetic_mode"]
        tc_handling = kinetic_fit_state["tc_handling"]
        st.dataframe(results_df, use_container_width=True)
        selected_resonator = st.selectbox(
            "Resonator group to plot",
            results_df["group_id"].tolist(),
            key="kinetic_resonator_plot",
        )
        plot_df = kinetic_df[kinetic_df["group_id"] == selected_resonator]
        params_for_plot = params_by_resonator.get(selected_resonator)
        if params_for_plot:
            temperature = np.linspace(plot_df["temperature"].min(), plot_df["temperature"].max(), 200)
            fr_fit = kinetic_shift_model(
                temperature,
                params_for_plot["f0"],
                params_for_plot["alpha"],
                params_for_plot["tc"],
                params_for_plot["f_tls"],
                kinetic_mode,
            )
            fig = go.Figure()
            fig.add_trace(
                go.Scatter(
                    x=plot_df["temperature"],
                    y=plot_df["fr"] / 1e9,
                    mode="markers",
                    name="Data",
                )
            )
            fig.add_trace(go.Scatter(x=temperature, y=fr_fit / 1e9, mode="lines", name="Fit"))
            fig.update_layout(
                xaxis_title=format_axis_label("temperature"),
                yaxis_title="f_r (GHz)",
                title=f"Group {selected_resonator}",
            )
            apply_plot_style(fig, plot_font_size)
            st.plotly_chart(fig, use_container_width=True)
            if "cond" in results_df.columns:
                cond_value = results_df.loc[results_df["group_id"] == selected_resonator, "cond"].iloc[0]
                if np.isfinite(cond_value) and cond_value > 1e6:
                    st.warning(f"Fit covariance condition number is large ({cond_value:.2e}).")
    else:
        st.info("Global fit results are not available.")
