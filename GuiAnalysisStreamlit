def cluster_by_frequency(df: pd.DataFrame, tolerance_hz: float) -> pd.Series:
    fr_values = df["fr"].to_numpy()
    order = np.argsort(fr_values)
    group_labels = np.full(fr_values.shape, None, dtype=object)
    current_group = -1
    current_mean = None
    current_count = 0
    for idx in order:
        fr_value = fr_values[idx]
        if not np.isfinite(fr_value):
            continue
        if current_mean is None or abs(fr_value - current_mean) > tolerance_hz:
            current_group += 1
            current_mean = fr_value
            current_count = 1
        else:
            current_count += 1
            current_mean = current_mean + (fr_value - current_mean) / current_count
        group_labels[idx] = f"G{current_group + 1}"
    return pd.Series(group_labels, index=df.index)


def build_group_mapping(df: pd.DataFrame, experiment: str, chip: str) -> Dict[str, object]:
    groups: Dict[str, Dict[str, object]] = {}
    grouped = df.dropna(subset=["group_id"]).groupby("group_id")
    for group_id, group_df in grouped:
        points = [
            {
                "temperature": float(row["temperature"]),
                "power_dbm": float(row["power_dbm"]),
                "fr": float(row["fr"]),
                "source_pdf": row.get("source_pdf", ""),
                "resonator": row["resonator"],
            }
            for _, row in group_df.iterrows()
        ]
        groups[str(group_id)] = {"label": str(group_id), "points": points}
    return {
        "version": GROUP_MAPPING_VERSION,
        "experiment": experiment,
        "chip": chip,
        "groups": groups,
    }


def apply_group_mapping(
    df: pd.DataFrame,
    mapping: Dict[str, object],
    fr_tolerance_hz: float,
) -> Tuple[pd.Series, int]:
    assignments = pd.Series(index=df["row_id"], data=None, dtype=object)
    source_pdf_map: Dict[str, List[Tuple[str, Dict[str, object]]]] = {}
    temp_power_map: Dict[Tuple[float, float], List[Dict[str, object]]] = {}
    groups = mapping.get("groups", {})
    for group_id, group_data in groups.items():
        points = group_data.get("points", [])
        for point in points:
            source_pdf = point.get("source_pdf", "")
            if source_pdf:
                source_pdf_map.setdefault(source_pdf, []).append((group_id, point))
            key = (round(float(point["temperature"]), 4), round(float(point["power_dbm"]), 3))
            temp_power_map.setdefault(key, []).append({**point, "group_id": group_id})

    unmatched = 0
    for row in df.itertuples(index=False):
        row_id = row.row_id
        group_id = None
        if row.source_pdf and row.source_pdf in source_pdf_map:
            candidates = source_pdf_map[row.source_pdf]
            group_id = min(candidates, key=lambda item: abs(row.fr - float(item[1]["fr"])))[0]
        else:
            key = (round(float(row.temperature), 4), round(float(row.power_dbm), 3))
            candidates = temp_power_map.get(key, [])
            if candidates:
                closest = min(candidates, key=lambda item: abs(row.fr - float(item["fr"])))
                if abs(row.fr - float(closest["fr"])) <= fr_tolerance_hz:
                    group_id = closest["group_id"]
        if group_id:
            assignments.loc[row_id] = group_id
        else:
            unmatched += 1
    return assignments, unmatched


def filter_dataframe(df: pd.DataFrame, selections: Dict[str, List[str]]) -> pd.DataFrame:
    filtered = df.copy()
    for key, values in selections.items():
        if values:
            filtered = filtered[filtered[key].isin(values)]
    return filtered


def _numeric_range(series: pd.Series) -> Optional[Tuple[float, float]]:
    numeric = pd.to_numeric(series, errors="coerce")
    numeric = numeric[np.isfinite(numeric)]
    if numeric.empty:
        return None
    return float(numeric.min()), float(numeric.max())


def _sync_selection(options: List[object], state_key: str) -> List[object]:
    if state_key not in st.session_state:
        st.session_state[state_key] = []
    current = st.session_state[state_key]
    if current:
        current = [value for value in current if value in options]
    st.session_state[state_key] = current
    return current


def _apply_multiselect_filter(
    df: pd.DataFrame,
    key: str,
    label: str,
    options: List[object],
) -> Tuple[pd.DataFrame, List[object]]:
    state_key = f"filter::{key}"
    _sync_selection(options, state_key)
    selection = st.sidebar.multiselect(label, options, key=state_key)
    if selection:
        df = df[df[key].isin(selection)]
    return df, selection


def _apply_range_filter(
    df: pd.DataFrame,
    key: str,
    label: str,
) -> Tuple[pd.DataFrame, Optional[Tuple[float, float]]]:
    range_limits = _numeric_range(df[key])
    if range_limits is None:
        st.sidebar.write(f"{label}: no data available")
        return df, None
    min_value, max_value = range_limits
    if min_value == max_value:
        st.sidebar.write(f"{label}: {min_value}")
        return df, (min_value, max_value)
    state_key = f"filter::{key}_range"
    limits_key = f"{state_key}::limits"
    previous_limits = st.session_state.get(limits_key, (min_value, max_value))
    default_range = st.session_state.get(state_key, (min_value, max_value))
    if not isinstance(default_range, (tuple, list)) or len(default_range) != 2:
        default_range = (min_value, max_value)
    if not isinstance(previous_limits, (tuple, list)) or len(previous_limits) != 2:
        previous_limits = (min_value, max_value)
    previous_min, previous_max = previous_limits
    default_low, default_high = float(default_range[0]), float(default_range[1])
    if min_value < previous_min and np.isclose(default_low, previous_min):
        default_low = min_value
    if max_value > previous_max and np.isclose(default_high, previous_max):
        default_high = max_value
    default_range = (
        max(min_value, float(default_low)),
        min(max_value, float(default_high)),
    )
    if default_range[0] > default_range[1]:
        default_range = (min_value, max_value)
    selection = st.sidebar.slider(
        label,
        min_value=min_value,
        max_value=max_value,
        value=default_range,
        key=state_key,
    )
    st.session_state[limits_key] = (min_value, max_value)
    df = df[(df[key] >= selection[0]) & (df[key] <= selection[1])]
    return df, selection


def _apply_date_range_filter(
    df: pd.DataFrame,
    key: str,
    label: str,
) -> Tuple[pd.DataFrame, Optional[Tuple[pd.Timestamp, pd.Timestamp]]]:
    dates = pd.to_datetime(df[key], errors="coerce")
    dates = dates.dropna()
    if dates.empty:
        st.sidebar.write(f"{label}: no data available")
        return df, None
    min_date = dates.min().date()
    max_date = dates.max().date()
    state_key = f"filter::{key}_range"
    default_range = st.session_state.get(state_key, (min_date, max_date))
    if isinstance(default_range, (tuple, list)):
        if len(default_range) >= 2:
            start_date, end_date = default_range[0], default_range[1]
        else:
            start_date = default_range[0] if default_range else min_date
            end_date = start_date
    else:
        start_date = default_range
        end_date = default_range
    if start_date is None or end_date is None:
        return df, None
    start_date = max(min_date, start_date)
    end_date = min(max_date, end_date)
    if start_date > end_date:
        start_date, end_date = min_date, max_date
    selection = st.sidebar.date_input(
        label,
        value=(start_date, end_date),
        min_value=min_date,
        max_value=max_date,
        key=state_key,
    )
    if selection is None:
        return df, None
    if isinstance(selection, (tuple, list)):
        if len(selection) == 0:
            return df, None
        if len(selection) >= 2:
            start_date, end_date = selection[0], selection[1]
        else:
            start_date = selection[0]
            end_date = selection[0]
    else:
        start_date = selection
        end_date = selection
    if start_date is None or end_date is None:
        return df, None
    df = df[(df[key].dt.date >= start_date) & (df[key].dt.date <= end_date)]
    return df, (pd.Timestamp(start_date), pd.Timestamp(end_date))


def tls_term(
    temperature: np.ndarray,
    drive: np.ndarray,
    fr_hz: np.ndarray,
    delta_tls: float,
    n_c: float,
    alpha: float,
) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    return delta_tls * np.tanh(scaled) / (1.0 + drive / n_c) ** alpha


def qp_term(temperature: np.ndarray, fr_hz: np.ndarray, q_qp0: float, delta: float) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    scaled = np.clip(scaled, 1e-6, 1e3)
    exponent = np.clip(-delta / (LOSS_BOLTZMANN * temperature), -700, 700)
    return (1.0 / q_qp0) * np.exp(exponent) * np.sinh(scaled) * k0(scaled)


def to_hz(frequency: np.ndarray) -> np.ndarray:
    if np.nanmax(frequency) < 1e6:
        return frequency * 1e9
    return frequency


def model_inv_q(
    temperature: np.ndarray,
    drive: np.ndarray,
    fr_hz: np.ndarray,
    params: Dict[str, float],
    fit_mode: str,
    alpha: float,
) -> Dict[str, np.ndarray]:
    inv_q_other = np.full_like(temperature, 1.0 / params["Qother"])
    inv_q_tls1 = np.zeros_like(temperature)
    inv_q_tls2 = np.zeros_like(temperature)
    inv_q_qp = np.zeros_like(temperature)

    if "QTLS" in fit_mode:
        inv_q_tls1 = tls_term(
            temperature,
            drive,
            fr_hz,
            params["delta_tls1_0"],
            params["n_c1"],
            alpha,
        )
    if "QTLS2" in fit_mode:
        inv_q_tls2 = tls_term(
            temperature,
            drive,
            fr_hz,
            params["delta_tls2_0"],
            params["n_c2"],
            alpha,
        )
    if "Qqp" in fit_mode:
        inv_q_qp = qp_term(
            temperature,
            fr_hz,
            params["Q_qp0"],
            params["Delta"],
        )

    inv_q_total = inv_q_other + inv_q_tls1 + inv_q_tls2 + inv_q_qp
    return {
        "inv_q_total": inv_q_total,
        "inv_q_other": inv_q_other,
        "inv_q_tls1": inv_q_tls1,
        "inv_q_tls2": inv_q_tls2,
        "inv_q_qp": inv_q_qp,
    }


def build_param_template(fit_mode: str, alpha_fit: bool, delta_fit: bool, tc_kelvin: float) -> Tuple[List[str], Dict[str, float]]:
    names = ["Qother"]
    defaults = {
        "Qother": 1e6,
        "delta_tls1_0": 1e-6,
        "n_c1": 1.0,
        "delta_tls2_0": 1e-6,
        "n_c2": 1.0,
        "Q_qp0": 1e6,
        "Delta": 1.76 * LOSS_BOLTZMANN * tc_kelvin,
        "alpha": 0.5,
    }
    if "QTLS" in fit_mode:
        names.extend(["delta_tls1_0", "n_c1"])
    if "QTLS2" in fit_mode:
        names.extend(["delta_tls2_0", "n_c2"])
    if "Qqp" in fit_mode:
        names.append("Q_qp0")
        if delta_fit:
            names.append("Delta")
    if alpha_fit and "QTLS" in fit_mode:
        names.append("alpha")
    return names, defaults




def build_loss_bounds(delta_tc_bounds: Tuple[float, float]) -> Tuple[Dict[str, float], Dict[str, float]]:
    delta_min = 1.76 * LOSS_BOLTZMANN * min(delta_tc_bounds)
    delta_max = 1.76 * LOSS_BOLTZMANN * max(delta_tc_bounds)
    lower_bounds = {
        "Qother": 1e3,
        "delta_tls1_0": 1e-12,
        "n_c1": 1e-12,
        "delta_tls2_0": 1e-12,
        "n_c2": 1e-12,
        "Q_qp0": 1.0,
        "Delta": delta_min,
        "alpha": 1e-6,
    }
    upper_bounds = {
        "Qother": 1e10,
        "delta_tls1_0": np.inf,
        "n_c1": np.inf,
        "delta_tls2_0": np.inf,
        "n_c2": np.inf,
        "Q_qp0": 1e10,
        "Delta": delta_max,
        "alpha": 2.0,
    }
    return lower_bounds, upper_bounds

def fit_inv_q(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    initial_params: Optional[Dict[str, float]] = None,
    random_starts: int = 1,
    loss: str = "linear",
    f_scale: float = 1.0,
    seed: Optional[int] = None,
    delta_strategy: str = "fit",
    delta_tc_bounds: Tuple[float, float] = (0.3, 16.0),
    delta_search_steps: int = 20,
) -> Tuple[Dict[str, float], Dict[str, np.ndarray]]:
    def fit_core(
        tc_value: float,
        core_delta_fit: bool,
    ) -> Tuple[Dict[str, float], Dict[str, np.ndarray], float]:
        temperature = df["temperature"].to_numpy()
        fr_hz = to_hz(df["fr"].to_numpy())
        q_meas = df["Qi"].to_numpy()
        drive = df["drive"].to_numpy()
        inv_q = 1.0 / q_meas
        q_err = df["Qi_err"].to_numpy() if "Qi_err" in df.columns else None
        inv_q_err = None if q_err is None else (q_err / (q_meas**2))

        param_names, defaults = build_param_template(fit_mode, alpha_fit, core_delta_fit, tc_value)
        if np.isfinite(q_meas).any():
            defaults["Qother"] = float(np.nanmax(q_meas))
        if np.isfinite(q_meas).any():
            defaults["Q_qp0"] = max(defaults.get("Q_qp0", 1e6), float(np.nanmax(q_meas)))
        if initial_params:
            defaults.update(initial_params)
        initial = np.array([defaults[name] for name in param_names], dtype=float)
        lower_bounds, upper_bounds = build_loss_bounds(delta_tc_bounds)
        if bounds_override:
            for key, (lower_value, upper_value) in bounds_override.items():
                if key in lower_bounds:
                    lower_bounds[key] = lower_value
                if key in upper_bounds:
                    upper_bounds[key] = upper_value
        lower = np.array([lower_bounds[name] for name in param_names], dtype=float)
        upper = np.array([upper_bounds[name] for name in param_names], dtype=float)
        span_floor = 1e-12
        for idx in range(lower.size):
            if not np.isfinite(lower[idx]) or not np.isfinite(upper[idx]):
                continue
            if lower[idx] >= upper[idx]:
                bump = max(abs(lower[idx]) * 1e-12, span_floor)
                upper[idx] = lower[idx] + bump
            initial[idx] = min(max(initial[idx], lower[idx]), upper[idx])

        def residuals(param_values: np.ndarray) -> np.ndarray:
            params = defaults.copy()
            params.update(dict(zip(param_names, param_values)))
            alpha = params.get("alpha", defaults["alpha"])
            model = model_inv_q(temperature, drive, fr_hz, params, fit_mode, alpha)["inv_q_total"]
            resid = model - inv_q
            if inv_q_err is not None and np.all(inv_q_err > 0):
                resid = resid / inv_q_err
            return resid

        rng = np.random.default_rng(seed)
        n_starts = max(int(random_starts), 1)
        best_result = None
        for attempt in range(n_starts):
            if attempt == 0:
                start = initial
            else:
                start = initial.copy()
                for idx, name in enumerate(param_names):
                    low = lower[idx]
                    high = upper[idx]
                    if not np.isfinite(low):
                        low = 0.0
                    if not np.isfinite(high):
                        high = max(low + 1.0, defaults[name] * 10.0)
                    if high <= low:
                        start[idx] = low
                    elif low > 0 and high > 0:
                        start[idx] = float(np.exp(rng.uniform(np.log(low), np.log(high))))
                    else:
                        start[idx] = float(rng.uniform(low, high))
            result = least_squares(
                residuals,
                start,
                bounds=(lower, upper),
                max_nfev=20000,
                loss=loss,
                f_scale=f_scale,
            )
            if best_result is None or result.cost < best_result.cost:
                best_result = result
        fitted = defaults.copy()
        fitted.update(dict(zip(param_names, best_result.x)))
        alpha_val = fitted.get("alpha", defaults["alpha"])
        components = model_inv_q(temperature, drive, fr_hz, fitted, fit_mode, alpha_val)
        return fitted, components, float(best_result.cost)

    if not delta_fit or "Qqp" not in fit_mode or delta_strategy == "fit":
        fitted, components, _ = fit_core(tc_kelvin, delta_fit)
        return fitted, components

    tc_low, tc_high = sorted(delta_tc_bounds)
    tc_low = max(tc_low, 1e-6)
    tc_high = max(tc_high, tc_low + 1e-6)
    cache: Dict[float, Tuple[Dict[str, float], Dict[str, np.ndarray], float]] = {}

    def evaluate(tc_value: float) -> float:
        if tc_value in cache:
            return cache[tc_value][2]
        fitted, components, cost = fit_core(tc_value, False)
        cache[tc_value] = (fitted, components, cost)
        return cost

    steps = max(int(delta_search_steps), 3)
    grid_tcs = np.linspace(tc_low, tc_high, steps)
    grid_costs = np.array([evaluate(float(tc_value)) for tc_value in grid_tcs], dtype=float)

    best_index = int(np.argmin(grid_costs))
    bracket_low = float(grid_tcs[max(best_index - 1, 0)])
    bracket_high = float(grid_tcs[min(best_index + 1, grid_tcs.size - 1)])

    if bracket_high - bracket_low > 1e-9:
        result = minimize_scalar(
            lambda tc_value: evaluate(float(tc_value)),
            bounds=(bracket_low, bracket_high),
            method="bounded",
            options={"maxiter": max(50, steps * 5)},
        )
        if result.success:
            evaluate(float(result.x))

    best_tc = min(cache, key=lambda key: cache[key][2])
    best_fitted, best_components, _ = cache[best_tc]
    return best_fitted, best_components


def add_drive_column(df: pd.DataFrame) -> Tuple[pd.DataFrame, bool, str]:
    df = df.copy()
    if "n_photon" in df.columns:
        df["drive"] = df["n_photon"]
        return df, False, "n_photon"
    if "photon_number" in df.columns:
        df["drive"] = df["photon_number"]
        return df, False, "photon_number"
    if "power_dbm" in df.columns:
        df["drive_proxy"] = 10.0 ** (df["power_dbm"] / 10.0)
        df["drive"] = df["drive_proxy"]
        return df, True, "drive_proxy"
    df["drive"] = np.nan
    return df, True, "drive_proxy"


def build_fit_mode(include_tls1: bool, include_tls2: bool, include_qp: bool) -> str:
    mode_parts = ["Qother"]
    if include_tls1:
        mode_parts.append("QTLS")
    if include_tls2:
        mode_parts.append("QTLS2")
    if include_qp:
        mode_parts.append("Qqp")
    return "+".join(mode_parts)


def build_start_parameters(df: pd.DataFrame, fit_mode: str) -> Tuple[Dict[str, float], Dict[str, Tuple[float, float]]]:
    include_tls1 = "QTLS" in fit_mode
    include_tls2 = "QTLS2" in fit_mode
    include_qp = "Qqp" in fit_mode

    qimax = float(np.nanmax(df["Qi"].to_numpy()))
    qother_lower = max(qimax, 1e3)
    qother_upper = max(10.0 * qimax, qother_lower * 1.000001)

    starts: Dict[str, float] = {"Qother": qother_lower}
    bounds_override: Dict[str, Tuple[float, float]] = {"Qother": (qother_lower, qother_upper)}

    if include_qp and "power_dbm" in df.columns:
        qp_df = df[df["power_dbm"] == df["power_dbm"].max()]
        if not qp_df.empty:
            starts["Q_qp0"] = max(float(np.nanmedian(qp_df["Qi"])), 1.0)

    if include_tls1 and "temperature" in df.columns:
        min_temp = float(df["temperature"].min())
        tls1_df = df[np.isclose(df["temperature"], min_temp)]
        if not tls1_df.empty:
            spread = float(np.nanstd((1.0 / tls1_df["Qi"]).to_numpy()))
            starts["delta_tls1_0"] = max(spread, 1e-9)
            starts["n_c1"] = max(float(np.nanmedian(tls1_df["drive"])), 1e-9)

    if include_tls2 and "power_dbm" in df.columns and "temperature" in df.columns:
        tls2_list = []
        for _, t_df in df.groupby("temperature"):
            low_power = t_df["power_dbm"].min()
            tls2_list.append(t_df[t_df["power_dbm"] == low_power])
        if tls2_list:
            tls2_df = pd.concat(tls2_list, ignore_index=True)
            spread2 = float(np.nanstd((1.0 / tls2_df["Qi"]).to_numpy()))
            starts["delta_tls2_0"] = max(spread2, 1e-9)
            starts["n_c2"] = max(float(np.nanmedian(tls2_df["drive"])), 1e-9)

    return starts, bounds_override


def adam_refine_fit(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    initial_params: Dict[str, float],
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    steps: int = 200,
) -> Dict[str, float]:
    param_names, defaults = build_param_template(fit_mode, alpha_fit, delta_fit, tc_kelvin)
    defaults.update(initial_params)
    x = np.array([defaults[name] for name in param_names], dtype=float)

    lower_bounds, upper_bounds = build_loss_bounds((0.3, 16.0))
    if bounds_override:
        for key, (low, high) in bounds_override.items():
            if key in lower_bounds:
                lower_bounds[key] = low
                upper_bounds[key] = high

    lower = np.array([lower_bounds[name] for name in param_names], dtype=float)
    upper = np.array([upper_bounds[name] for name in param_names], dtype=float)
    x = np.minimum(np.maximum(x, lower), upper)

    temperature = df["temperature"].to_numpy()
    fr_hz = to_hz(df["fr"].to_numpy())
    drive = df["drive"].to_numpy()
    inv_q_target = 1.0 / df["Qi"].to_numpy()

    def objective(x_vec: np.ndarray) -> float:
        params = defaults.copy()
        params.update(dict(zip(param_names, x_vec)))
        alpha = params.get("alpha", defaults["alpha"])
        pred = model_inv_q(temperature, drive, fr_hz, params, fit_mode, alpha)["inv_q_total"]
        resid = pred - inv_q_target
        return float(np.nanmean(resid**2))

    lr = 0.02
    beta1 = 0.9
    beta2 = 0.999
    eps = 1e-8
    m = np.zeros_like(x)
    v = np.zeros_like(x)
    best_x = x.copy()
    best_loss = objective(x)

    for step in range(1, steps + 1):
        grad = np.zeros_like(x)
        for i in range(x.size):
            h = max(abs(x[i]) * 1e-4, 1e-8)
            x_up = x.copy()
            x_dn = x.copy()
            x_up[i] = min(x_up[i] + h, upper[i])
            x_dn[i] = max(x_dn[i] - h, lower[i])
            grad[i] = (objective(x_up) - objective(x_dn)) / max((x_up[i] - x_dn[i]), 1e-12)

        m = beta1 * m + (1 - beta1) * grad
        v = beta2 * v + (1 - beta2) * (grad**2)
        m_hat = m / (1 - beta1**step)
        v_hat = v / (1 - beta2**step)
        x = x - lr * m_hat / (np.sqrt(v_hat) + eps)
        x = np.minimum(np.maximum(x, lower), upper)

        loss_val = objective(x)
        if loss_val < best_loss:
            best_loss = loss_val
            best_x = x.copy()

    refined = defaults.copy()
    refined.update(dict(zip(param_names, best_x)))
    return refined


def staged_fit_inv_q(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    random_starts: int = 1,
    loss: str = "linear",
    f_scale: float = 1.0,
    seed: Optional[int] = None,
    delta_strategy: str = "fit",
    delta_tc_bounds: Tuple[float, float] = (0.3, 16.0),
    delta_search_steps: int = 20,
    cycle_passes: int = 0,
    converging: bool = False,
    convergence_tol: float = 1e-4,
    max_converging_cycles: int = 20,
    converging_refit_delta: bool = False,
) -> Tuple[Dict[str, float], Dict[str, np.ndarray], Dict[str, float], Dict[str, np.ndarray]]:
    starts, physics_bounds = build_start_parameters(df, fit_mode)
    merged_bounds = dict(bounds_override or {})
    merged_bounds.update(physics_bounds)

    initial_params, initial_components = fit_inv_q(
        df,
        fit_mode,
        alpha_fit,
        delta_fit,
        tc_kelvin,
        bounds_override=merged_bounds,
        initial_params=starts,
        random_starts=random_starts,
        loss=loss,
        f_scale=f_scale,
        seed=seed,
        delta_strategy=delta_strategy,
        delta_tc_bounds=delta_tc_bounds,
        delta_search_steps=delta_search_steps,
    )

    refined_start = adam_refine_fit(
        df,
        fit_mode,
        alpha_fit,
        delta_fit,
        tc_kelvin,
        initial_params,
        bounds_override=merged_bounds,
        steps=200,
    )

    final_params, final_components = fit_inv_q(
        df,
        fit_mode,
        alpha_fit,
        delta_fit,
        tc_kelvin,
        bounds_override=merged_bounds,
        initial_params=refined_start,
        random_starts=1,
        loss=loss,
        f_scale=f_scale,
        seed=seed,
        delta_strategy=delta_strategy,
        delta_tc_bounds=delta_tc_bounds,
        delta_search_steps=delta_search_steps,
    )

    cycle_delta_fit = bool(delta_fit and (delta_strategy == "fit" or converging_refit_delta))
    cycle_param_names, _ = build_param_template(fit_mode, alpha_fit, cycle_delta_fit, tc_kelvin)
    cycle_param_names = [name for name in cycle_param_names if name in final_params]
    temperature = df["temperature"].to_numpy()
    fr_hz = to_hz(df["fr"].to_numpy())
    drive = df["drive"].to_numpy()
    q_meas = df["Qi"].to_numpy()
    inv_q_target = 1.0 / q_meas
    q_err = df["Qi_err"].to_numpy() if "Qi_err" in df.columns else None
    inv_q_err = None if q_err is None else (q_err / (q_meas**2))

    lower_bounds, upper_bounds = build_loss_bounds(delta_tc_bounds)
    if bounds_override:
        for key, (low, high) in bounds_override.items():
            if key in lower_bounds:
                lower_bounds[key] = low
                upper_bounds[key] = high

    def cycle_objective(params_dict: Dict[str, float]) -> float:
        alpha_val = params_dict.get("alpha", 0.5)
        pred = model_inv_q(temperature, drive, fr_hz, params_dict, fit_mode, alpha_val)["inv_q_total"]
        resid = pred - inv_q_target
        if inv_q_err is not None and np.all(inv_q_err > 0):
            resid = resid / inv_q_err
        return float(np.nanmean(resid**2))

    def optimize_one_parameter(params_dict: Dict[str, float], name: str) -> Dict[str, float]:
        low = lower_bounds.get(name, -np.inf)
        high = upper_bounds.get(name, np.inf)
        if not np.isfinite(low):
            low = -1e20
        if not np.isfinite(high):
            high = 1e20
        if low >= high:
            return params_dict

        x0 = float(np.clip(params_dict[name], low, high))

        def residuals(x_arr: np.ndarray) -> np.ndarray:
            candidate = params_dict.copy()
            candidate[name] = float(x_arr[0])
            alpha_val = candidate.get("alpha", 0.5)
            pred = model_inv_q(temperature, drive, fr_hz, candidate, fit_mode, alpha_val)["inv_q_total"]
            resid = pred - inv_q_target
            if inv_q_err is not None and np.all(inv_q_err > 0):
                resid = resid / inv_q_err
            return resid

        result = least_squares(
            residuals,
            np.array([x0], dtype=float),
            bounds=(np.array([low], dtype=float), np.array([high], dtype=float)),
            max_nfev=2000,
            loss=loss,
            f_scale=f_scale,
        )
        updated = params_dict.copy()
        updated[name] = float(result.x[0])
        return updated

    if cycle_param_names and (cycle_passes > 0 or converging):
        current_params = final_params.copy()
        previous_cycle_cost = cycle_objective(current_params)
        max_cycles = max_converging_cycles if converging else max(int(cycle_passes), 0)
        for _ in range(max_cycles):
            trial_params = current_params.copy()
            for name in cycle_param_names:
                trial_params = optimize_one_parameter(trial_params, name)
            trial_cost = cycle_objective(trial_params)
            improved = previous_cycle_cost - trial_cost
            if improved > 0:
                current_params = trial_params
                previous_cycle_cost = trial_cost
            if converging and improved <= max(convergence_tol, 0.0):
                break
        alpha_final = current_params.get("alpha", 0.5)
        final_params = current_params
        final_components = model_inv_q(temperature, drive, fr_hz, final_params, fit_mode, alpha_final)

    return initial_params, initial_components, final_params, final_components


def mb_sigma_ratio(temperature: np.ndarray, tc: float) -> np.ndarray:
    t_ratio = np.clip(temperature / tc, 1e-6, 0.9999)
    return 1.0 / np.sqrt(1.0 - t_ratio**4)


def tls_dispersion_term(temperature: np.ndarray, f0_hz: float, f_tls: float) -> np.ndarray:
    arg = 0.5 + (PLANCK * f0_hz) / (2.0 * np.pi * 1j * LOSS_BOLTZMANN * temperature)
    psi = digamma(arg)
    real_part = np.real(psi)
    log_term = np.log((PLANCK * f0_hz) / (LOSS_BOLTZMANN * temperature))
    return (f_tls / np.pi) * (real_part - log_term)


def kinetic_shift_model(
    temperature: np.ndarray,
    f0_hz: float,
    alpha: float,
    tc: float,
    f_tls: float,
    mode: str,
) -> np.ndarray:
    mb_term = -0.5 * alpha * (mb_sigma_ratio(temperature, tc) - 1.0)
    tls_term = tls_dispersion_term(temperature, f0_hz, f_tls)
    if mode == "MB":
        return f0_hz * (1.0 + mb_term)
    if mode == "TLS":
        return f0_hz * (1.0 + tls_term)
    return f0_hz * (1.0 + mb_term + tls_term)


def fit_kinetic(
    df: pd.DataFrame,
    tc_kelvin: float,
    alpha_init: float,
    mode: str,
    f_tls_init: float,
    fit_tc: bool,
    tc_bounds: Tuple[float, float],
) -> Tuple[np.ndarray, np.ndarray]:
    temperature = df["temperature"].to_numpy()
    fr_hz = df["fr"].to_numpy()
    initial = [fr_hz.max(), alpha_init, tc_kelvin, f_tls_init]

    def model(temp: np.ndarray, f0: float, alpha: float, tc: float, f_tls: float) -> np.ndarray:
        return kinetic_shift_model(temp, f0, alpha, tc, f_tls, mode)

    tc_min, tc_max = tc_bounds
    lower = [0.0, 0.0, tc_min, -1.0]
    upper = [np.inf, 5.0, tc_max, 1.0]

    if mode == "MB":
        if fit_tc:
            initial = [fr_hz.max(), alpha_init, tc_kelvin]
            lower = [0.0, 0.0, tc_min]
            upper = [np.inf, 5.0, tc_max]

            def model(temp: np.ndarray, f0: float, alpha: float, tc: float) -> np.ndarray:
                return kinetic_shift_model(temp, f0, alpha, tc, 0.0, "MB")

            params, covariance = curve_fit(
                model,
                temperature,
                fr_hz,
                p0=initial,
                bounds=(lower, upper),
                maxfev=10000,
            )
            return params, covariance
        initial = [fr_hz.max(), alpha_init]
        lower = [0.0, 0.0]
        upper = [np.inf, 5.0]

        def model(temp: np.ndarray, f0: float, alpha: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, alpha, tc_kelvin, 0.0, "MB")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    if mode == "TLS":
        initial = [fr_hz.max(), f_tls_init]
        lower = [0.0, -1.0]
        upper = [np.inf, 1.0]

        def model(temp: np.ndarray, f0: float, f_tls: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, 0.0, tc_kelvin, f_tls, "TLS")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    if fit_tc:
        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    initial = [fr_hz.max(), alpha_init, f_tls_init]
    lower = [0.0, 0.0, -1.0]
    upper = [np.inf, 5.0, 1.0]

    def model(temp: np.ndarray, f0: float, alpha: float, f_tls: float) -> np.ndarray:
        return kinetic_shift_model(temp, f0, alpha, tc_kelvin, f_tls, mode)

    params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
    return params, covariance


