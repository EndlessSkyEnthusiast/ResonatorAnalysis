    mean_axis = f"{axis}_mean"
    if mean_axis in df.columns:
        return mean_axis
    return None


def blend_with_white(base_rgb: Tuple[int, int, int], weight: float) -> str:
    clamped = max(0.0, min(1.0, weight))
    red = int(255 * (1 - clamped) + base_rgb[0] * clamped)
    green = int(255 * (1 - clamped) + base_rgb[1] * clamped)
    blue = int(255 * (1 - clamped) + base_rgb[2] * clamped)
    return f"rgb({red},{green},{blue})"


def parse_color_to_hex(color_value: Optional[str], fallback: str = "#1f77b4") -> str:
    if not color_value:
        return fallback
    value = str(color_value).strip()
    if value.startswith("#") and len(value) in {4, 7}:
        return value
    rgb_match = re.match(r"rgb\((\d+)\s*,\s*(\d+)\s*,\s*(\d+)\)", value)
    if rgb_match:
        red, green, blue = [max(0, min(255, int(channel))) for channel in rgb_match.groups()]
        return f"#{red:02x}{green:02x}{blue:02x}"
    return fallback


