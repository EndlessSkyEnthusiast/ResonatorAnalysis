        legend={"font": {"size": font_size}, "title": {"font": {"size": font_size}}},
    )
    fig.update_xaxes(
        tickfont={"size": font_size},
        title_font={"size": font_size},
    )
    fig.update_yaxes(
        tickfont={"size": font_size},
        title_font={"size": font_size},
    )
    fig.update_coloraxes(
        colorbar_tickfont={"size": font_size},
        colorbar_title_font={"size": font_size},
    )


