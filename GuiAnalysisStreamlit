@st.cache_data(show_spinner=False)
def load_hdf5(path: Path) -> pd.DataFrame:
    rows: List[Dict[str, object]] = []
    with h5py.File(path, "r") as h5file:
        for experiment in h5file:
            exp_group = h5file[experiment]
            for chip in exp_group:
                chip_group = exp_group[chip]
                for temperature in chip_group:
                    temp_group = chip_group[temperature]
                    for resonator in temp_group:
                        res_group = temp_group[resonator]
                        for power in res_group:
                            power_group = res_group[power]
                            attrs = power_group.attrs
                            rows.append(
                                {
                                    "experiment": experiment,
                                    "chip": chip,
                                    "temperature": float(temperature),
                                    "resonator": resonator,
                                    "power_dbm": float(power),
                                    "fr": float(attrs.get("fr")),
                                    "Ql": float(attrs.get("Ql")),
                                    "Qc": float(attrs.get("Qc")),
                                    "Qi": float(attrs.get("Qi")),
                                    "Qi_err": float(attrs.get("Qi_err")),
                                    "n_photon": float(
                                        attrs.get("n_photon", attrs.get("photon_number", np.nan))
                                    ),
                                    "source_pdf": attrs.get("source_pdf", ""),
                                }
                            )
    df = pd.DataFrame(rows)
    df["resonator_id"] = (
        df["experiment"]
        + "|"
        + df["chip"]
        + "|"
        + df["temperature"].astype(str)
        + "|"
        + df["resonator"]
    )
    return df


