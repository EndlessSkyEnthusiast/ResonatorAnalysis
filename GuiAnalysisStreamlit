st.subheader("Loss model fit (TLS + QP + Other)")
fit_columns = st.multiselect("Include columns", axis_options, default=["temperature", "Qi", "fr", "power_dbm"])

def build_fit_dataframe(source_df: pd.DataFrame) -> pd.DataFrame:
    df_fit = source_df.copy()
    if "Qi_mean" in df_fit.columns:
        df_fit["Qi"] = df_fit["Qi_mean"]
    if "fr_mean" in df_fit.columns:
        df_fit["fr"] = df_fit["fr_mean"]
    if "power_dbm" not in df_fit.columns and "power_dbm_mean" in df_fit.columns:
        df_fit["power_dbm"] = df_fit["power_dbm_mean"]
    if "Qi_err" not in df_fit.columns and "Qi_err_mean" in df_fit.columns:
        df_fit["Qi_err"] = df_fit["Qi_err_mean"]
    return df_fit

if aggregation_mode in {"By power", "By temperature", "By chip"}:
    fit_source = plot_df
elif aggregation_mode == "By resonator":
    fit_source = plot_df
else:
    fit_source = filtered_df

fit_df = build_fit_dataframe(fit_source).dropna(subset=fit_columns)

fit_mode = st.selectbox(
    "Fit mode",
    [
        "Qother",
        "Qother+QTLS",
        "Qother+Qqp",
        "Qother+QTLS+Qqp",
        "Qother+QTLS+QTLS2+Qqp",
    ],
)
fit_tc = st.number_input("Tc (K)", min_value=0.1, max_value=20.0, value=1.2, step=0.1)
alpha_fit = st.checkbox("Fit alpha (TLS exponent)", value=False)
delta_fit = st.checkbox("Fit Delta (QP gap)", value=False)
show_q_curves = st.checkbox("Show Q curves", value=False)
loss_function = st.selectbox("Loss function", ["linear", "soft_l1", "huber", "cauchy", "arctan"], index=1)
loss_scale = st.number_input("Loss scale (f_scale)", min_value=0.1, max_value=10.0, value=1.0, step=0.1)
random_starts = st.number_input("Random fit starts", min_value=1, max_value=50, value=5, step=1)
random_seed = st.number_input("Random seed", min_value=0, max_value=10_000, value=42, step=1)
custom_bounds = st.checkbox("Customize parameter bounds", value=False)

bounds_override = None
if custom_bounds:
    bounds_override = {}
    st.caption("Set parameter bounds (leave wide if unsure).")
    col1, col2 = st.columns(2)
    with col1:
        bounds_override["Qother"] = (
            st.number_input("Qother min", min_value=0.0, value=1.0, step=1.0),
            st.number_input("Qother max", min_value=1.0, value=1e9, step=1e6),
        )
        bounds_override["delta_tls1_0"] = (
            st.number_input("delta_tls1_0 min", min_value=0.0, value=0.0, step=1e-8, format="%.2e"),
