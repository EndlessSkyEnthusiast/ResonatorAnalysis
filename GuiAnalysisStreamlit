def _clipboard_value(value: object) -> str:
    if value is None:
        return "none"
    if isinstance(value, float) and not np.isfinite(value):
        return "none"
    if isinstance(value, (np.floating, np.integer)):
        return f"{float(value):.8g}"
    text = str(value).strip()
    return text if text else "none"


def _single_value_or_none(series: pd.Series) -> str:
    if series.empty:
        return "none"
    valid = series.dropna()
    if valid.empty:
        return "none"
    unique_values = valid.astype(str).str.strip().replace("", np.nan).dropna().unique()
    if len(unique_values) == 1:
        return _clipboard_value(unique_values[0])
    return "mixed"


def _chip_tokens_for_clipboard(chip_value: str) -> Dict[str, str]:
    if not chip_value or chip_value == "none" or chip_value == "mixed":
        return {}
    tokens = [token.strip() for token in str(chip_value).split("_") if token.strip()]
    parsed: Dict[str, str] = {
        "Comment": "none",
        "Temperatur": "none",
        "Argon Flow": "none",
        "Nitrogen Flow": "none",
        "Time": "none",
    }
    comments: List[str] = []
    for token in tokens:
        token_lower = token.lower()
        if parsed["Temperatur"] == "none":
            match = re.match(r"^(\d+(?:[\.,]\d+)?)c$", token_lower)
            if match:
                parsed["Temperatur"] = match.group(1).replace(",", ".")
                continue
        if parsed["Argon Flow"] == "none":
            match = re.match(r"^(\d+(?:[\.,]\d+)?)ar$", token_lower)
            if match:
                parsed["Argon Flow"] = match.group(1).replace(",", ".")
                continue
        if parsed["Nitrogen Flow"] == "none":
            match = re.match(r"^(\d+(?:[\.,]\d+)?)n2$", token_lower)
            if match:
                parsed["Nitrogen Flow"] = match.group(1).replace(",", ".")
                continue
        if parsed["Time"] == "none":
            match = re.match(r"^(\d+(?:[\.,]\d+)?)min$", token_lower)
            if match:
                parsed["Time"] = match.group(1).replace(",", ".")
                continue
        if re.match(r"^\d{8}$", token):
            continue
        if re.match(r"^\d+(?:[\.,]|-)\d+u?bar$", token_lower):
            continue
        comments.append(token)
    if comments:
        parsed["Comment"] = "_".join(comments)
    return parsed


