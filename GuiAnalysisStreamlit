def filter_dataframe(df: pd.DataFrame, selections: Dict[str, List[str]]) -> pd.DataFrame:
    filtered = df.copy()
    for key, values in selections.items():
        if values:
            filtered = filtered[filtered[key].isin(values)]
    return filtered


def tls_term(
    temperature: np.ndarray,
    drive: np.ndarray,
    fr_hz: np.ndarray,
    delta_tls: float,
    n_c: float,
    alpha: float,
) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    return delta_tls * np.tanh(scaled) / (1.0 + drive / n_c) ** alpha


def qp_term(temperature: np.ndarray, fr_hz: np.ndarray, q_qp0: float, delta: float) -> np.ndarray:
    scaled = PLANCK * fr_hz / (2 * LOSS_BOLTZMANN * temperature)
    scaled = np.clip(scaled, 1e-6, 1e3)
    exponent = np.clip(-delta / (LOSS_BOLTZMANN * temperature), -700, 700)
    return (1.0 / q_qp0) * np.exp(exponent) * np.sinh(scaled) * k0(scaled)


def to_hz(frequency: np.ndarray) -> np.ndarray:
    if np.nanmax(frequency) < 1e6:
        return frequency * 1e9
    return frequency


def model_inv_q(
    temperature: np.ndarray,
    drive: np.ndarray,
    fr_hz: np.ndarray,
    params: Dict[str, float],
    fit_mode: str,
    alpha: float,
) -> Dict[str, np.ndarray]:
    inv_q_other = np.full_like(temperature, 1.0 / params["Qother"])
    inv_q_tls1 = np.zeros_like(temperature)
    inv_q_tls2 = np.zeros_like(temperature)
    inv_q_qp = np.zeros_like(temperature)

    if "QTLS" in fit_mode:
        inv_q_tls1 = tls_term(
            temperature,
            drive,
            fr_hz,
            params["delta_tls1_0"],
            params["n_c1"],
            alpha,
        )
    if "QTLS2" in fit_mode:
        inv_q_tls2 = tls_term(
            temperature,
            drive,
            fr_hz,
            params["delta_tls2_0"],
            params["n_c2"],
            alpha,
        )
    if "Qqp" in fit_mode:
        inv_q_qp = qp_term(
            temperature,
            fr_hz,
            params["Q_qp0"],
            params["Delta"],
        )

    inv_q_total = inv_q_other + inv_q_tls1 + inv_q_tls2 + inv_q_qp
    return {
        "inv_q_total": inv_q_total,
        "inv_q_other": inv_q_other,
        "inv_q_tls1": inv_q_tls1,
        "inv_q_tls2": inv_q_tls2,
        "inv_q_qp": inv_q_qp,
    }


def build_param_template(fit_mode: str, alpha_fit: bool, delta_fit: bool, tc_kelvin: float) -> Tuple[List[str], Dict[str, float]]:
    names = ["Qother"]
    defaults = {
        "Qother": 1e6,
        "delta_tls1_0": 1e-6,
        "n_c1": 1.0,
        "delta_tls2_0": 1e-6,
        "n_c2": 1.0,
        "Q_qp0": 1e6,
        "Delta": 1.76 * LOSS_BOLTZMANN * tc_kelvin,
        "alpha": 0.5,
    }
    if "QTLS" in fit_mode:
        names.extend(["delta_tls1_0", "n_c1"])
    if "QTLS2" in fit_mode:
        names.extend(["delta_tls2_0", "n_c2"])
    if "Qqp" in fit_mode:
        names.append("Q_qp0")
        if delta_fit:
            names.append("Delta")
    if alpha_fit and "QTLS" in fit_mode:
        names.append("alpha")
    return names, defaults


def fit_inv_q(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    initial_params: Optional[Dict[str, float]] = None,
    random_starts: int = 1,
    loss: str = "linear",
    f_scale: float = 1.0,
    seed: Optional[int] = None,
    delta_strategy: str = "fit",
    delta_tc_bounds: Tuple[float, float] = (0.3, 16.0),
    delta_search_steps: int = 20,
) -> Tuple[Dict[str, float], Dict[str, np.ndarray]]:
    def fit_core(
        tc_value: float,
        core_delta_fit: bool,
    ) -> Tuple[Dict[str, float], Dict[str, np.ndarray], float]:
        temperature = df["temperature"].to_numpy()
        fr_hz = to_hz(df["fr"].to_numpy())
        q_meas = df["Qi"].to_numpy()
        drive = df["drive"].to_numpy()
        inv_q = 1.0 / q_meas
        q_err = df["Qi_err"].to_numpy() if "Qi_err" in df.columns else None
        inv_q_err = None if q_err is None else (q_err / (q_meas**2))

        param_names, defaults = build_param_template(fit_mode, alpha_fit, core_delta_fit, tc_value)
        if np.isfinite(q_meas).any():
            defaults["Qother"] = float(np.nanmax(q_meas))
        if np.isfinite(q_meas).any():
            defaults["Q_qp0"] = max(defaults.get("Q_qp0", 1e6), float(np.nanmax(q_meas)))
        if initial_params:
            defaults.update(initial_params)
        initial = np.array([defaults[name] for name in param_names], dtype=float)
        delta_min = 1.76 * LOSS_BOLTZMANN * min(delta_tc_bounds)
        delta_max = 1.76 * LOSS_BOLTZMANN * max(delta_tc_bounds)
        lower_bounds = {
            "Qother": 1e3,
            "delta_tls1_0": 1e-12,
            "n_c1": 1e-12,
            "delta_tls2_0": 1e-12,
            "n_c2": 1e-12,
            "Q_qp0": 1e3,
            "Delta": delta_min,
            "alpha": 1e-6,
        }
        upper_bounds = {
            "Qother": 1e10,
            "delta_tls1_0": np.inf,
            "n_c1": np.inf,
            "delta_tls2_0": np.inf,
            "n_c2": np.inf,
            "Q_qp0": 1e10,
            "Delta": delta_max,
            "alpha": 2.0,
        }
        if bounds_override:
            for key, (lower_value, upper_value) in bounds_override.items():
                if key in lower_bounds:
                    lower_bounds[key] = lower_value
                if key in upper_bounds:
                    upper_bounds[key] = upper_value
        lower = np.array([lower_bounds[name] for name in param_names], dtype=float)
        upper = np.array([upper_bounds[name] for name in param_names], dtype=float)
        span_floor = 1e-12
        for idx in range(lower.size):
            if not np.isfinite(lower[idx]) or not np.isfinite(upper[idx]):
                continue
            if lower[idx] >= upper[idx]:
                bump = max(abs(lower[idx]) * 1e-12, span_floor)
                upper[idx] = lower[idx] + bump
            initial[idx] = min(max(initial[idx], lower[idx]), upper[idx])

        def residuals(param_values: np.ndarray) -> np.ndarray:
            params = defaults.copy()
            params.update(dict(zip(param_names, param_values)))
            alpha = params.get("alpha", defaults["alpha"])
            model = model_inv_q(temperature, drive, fr_hz, params, fit_mode, alpha)["inv_q_total"]
            resid = model - inv_q
            if inv_q_err is not None and np.all(inv_q_err > 0):
                resid = resid / inv_q_err
            return resid

        rng = np.random.default_rng(seed)
        n_starts = max(int(random_starts), 1)
        best_result = None
        for attempt in range(n_starts):
            if attempt == 0:
                start = initial
            else:
                start = initial.copy()
                for idx, name in enumerate(param_names):
                    low = lower[idx]
                    high = upper[idx]
                    if not np.isfinite(low):
                        low = 0.0
                    if not np.isfinite(high):
                        high = max(low + 1.0, defaults[name] * 10.0)
                    if high <= low:
                        start[idx] = low
                    elif low > 0 and high > 0:
                        start[idx] = float(np.exp(rng.uniform(np.log(low), np.log(high))))
                    else:
                        start[idx] = float(rng.uniform(low, high))
            result = least_squares(
                residuals,
                start,
                bounds=(lower, upper),
                max_nfev=20000,
                loss=loss,
                f_scale=f_scale,
            )
            if best_result is None or result.cost < best_result.cost:
                best_result = result
        fitted = defaults.copy()
        fitted.update(dict(zip(param_names, best_result.x)))
        alpha_val = fitted.get("alpha", defaults["alpha"])
        components = model_inv_q(temperature, drive, fr_hz, fitted, fit_mode, alpha_val)
        return fitted, components, float(best_result.cost)

    if not delta_fit or "Qqp" not in fit_mode or delta_strategy == "fit":
        fitted, components, _ = fit_core(tc_kelvin, delta_fit)
        return fitted, components

    tc_low, tc_high = sorted(delta_tc_bounds)
    tc_low = max(tc_low, 1e-6)
    tc_high = max(tc_high, tc_low + 1e-6)
    cache: Dict[float, Tuple[Dict[str, float], Dict[str, np.ndarray], float]] = {}

    def evaluate(tc_value: float) -> float:
        if tc_value in cache:
            return cache[tc_value][2]
        fitted, components, cost = fit_core(tc_value, False)
        cache[tc_value] = (fitted, components, cost)
        return cost

    evaluate(tc_low)
    evaluate(tc_high)
    steps = max(int(delta_search_steps), 3)
    for _ in range(steps):
        tc_span = tc_high - tc_low
        tc_left = tc_low + tc_span / 3.0
        tc_right = tc_high - tc_span / 3.0
        cost_left = evaluate(tc_left)
        cost_right = evaluate(tc_right)
        if cost_left <= cost_right:
            tc_high = tc_right
        else:
            tc_low = tc_left

    best_tc = min(cache, key=lambda key: cache[key][2])
    best_fitted, best_components, _ = cache[best_tc]
    return best_fitted, best_components


def add_drive_column(df: pd.DataFrame) -> Tuple[pd.DataFrame, bool, str]:
    df = df.copy()
    if "n_photon" in df.columns:
        df["drive"] = df["n_photon"]
        return df, False, "n_photon"
    if "photon_number" in df.columns:
        df["drive"] = df["photon_number"]
        return df, False, "photon_number"
    if "power_dbm" in df.columns:
        df["drive_proxy"] = 10.0 ** (df["power_dbm"] / 10.0)
        df["drive"] = df["drive_proxy"]
        return df, True, "drive_proxy"
    df["drive"] = np.nan
    return df, True, "drive_proxy"


def build_fit_mode(include_tls1: bool, include_tls2: bool, include_qp: bool) -> str:
    mode_parts = ["Qother"]
    if include_tls1:
        mode_parts.append("QTLS")
    if include_tls2:
        mode_parts.append("QTLS2")
    if include_qp:
        mode_parts.append("Qqp")
    return "+".join(mode_parts)


def staged_fit_inv_q(
    df: pd.DataFrame,
    fit_mode: str,
    alpha_fit: bool,
    delta_fit: bool,
    tc_kelvin: float,
    bounds_override: Optional[Dict[str, Tuple[float, float]]] = None,
    random_starts: int = 1,
    loss: str = "linear",
    f_scale: float = 1.0,
    seed: Optional[int] = None,
    delta_strategy: str = "fit",
    delta_tc_bounds: Tuple[float, float] = (0.3, 16.0),
    delta_search_steps: int = 20,
    low_temp_max: float = 0.2,
    high_temp_min: float = 0.2,
) -> Tuple[Dict[str, float], Dict[str, np.ndarray]]:
    include_tls1 = "QTLS" in fit_mode
    include_tls2 = "QTLS2" in fit_mode
    include_qp = "Qqp" in fit_mode

    temperature = df["temperature"].to_numpy()
    drive = df["drive"].to_numpy()

    low_temp_mask = temperature <= low_temp_max
    low_temp_df = df[low_temp_mask] if np.any(low_temp_mask) else df
    drive_low = drive[low_temp_mask] if np.any(low_temp_mask) else drive
    if drive_low.size:
        drive_cut = np.nanquantile(drive_low, 0.8)
        high_drive_mask = drive >= drive_cut
    else:
        high_drive_mask = np.ones_like(drive, dtype=bool)
    q_other_subset = df[low_temp_mask & high_drive_mask] if np.any(low_temp_mask) else df[high_drive_mask]
    q_other_est = float(np.nanmedian(q_other_subset["Qi"])) if not q_other_subset.empty else float(np.nanmedian(df["Qi"]))
    initial_params = {"Qother": q_other_est}

    tls_mode = build_fit_mode(include_tls1, include_tls2, False)
    tls_df = df[temperature <= low_temp_max] if np.any(temperature <= low_temp_max) else df
    tls_params, _ = fit_inv_q(
        tls_df,
        tls_mode,
        alpha_fit,
        False,
        tc_kelvin,
        bounds_override=bounds_override,
        initial_params=initial_params,
        random_starts=random_starts,
        loss=loss,
        f_scale=f_scale,
        seed=seed,
        delta_strategy=delta_strategy,
        delta_tc_bounds=delta_tc_bounds,
        delta_search_steps=delta_search_steps,
    )

    qp_params = tls_params
    if include_qp:
        qp_bounds = dict(bounds_override or {})
        qp_bounds["Qother"] = (tls_params["Qother"], tls_params["Qother"])
        if include_tls1:
            qp_bounds["delta_tls1_0"] = (tls_params["delta_tls1_0"], tls_params["delta_tls1_0"])
            qp_bounds["n_c1"] = (tls_params["n_c1"], tls_params["n_c1"])
        if include_tls2:
            qp_bounds["delta_tls2_0"] = (tls_params["delta_tls2_0"], tls_params["delta_tls2_0"])
            qp_bounds["n_c2"] = (tls_params["n_c2"], tls_params["n_c2"])
        if alpha_fit:
            qp_bounds["alpha"] = (tls_params["alpha"], tls_params["alpha"])
        qp_df = df[temperature >= high_temp_min] if np.any(temperature >= high_temp_min) else df
        qp_params, _ = fit_inv_q(
            qp_df,
            build_fit_mode(include_tls1, include_tls2, True),
            alpha_fit,
            delta_fit,
            tc_kelvin,
            bounds_override=qp_bounds,
            initial_params=tls_params,
            random_starts=random_starts,
            loss=loss,
            f_scale=f_scale,
            seed=seed,
            delta_strategy=delta_strategy,
            delta_tc_bounds=delta_tc_bounds,
            delta_search_steps=delta_search_steps,
        )

    final_params, components = fit_inv_q(
        df,
        build_fit_mode(include_tls1, include_tls2, include_qp),
        alpha_fit,
        delta_fit,
        tc_kelvin,
        bounds_override=bounds_override,
        initial_params=qp_params,
        random_starts=random_starts,
        loss=loss,
        f_scale=f_scale,
        seed=seed,
        delta_strategy=delta_strategy,
        delta_tc_bounds=delta_tc_bounds,
        delta_search_steps=delta_search_steps,
    )
    return final_params, components


def mb_sigma_ratio(temperature: np.ndarray, tc: float) -> np.ndarray:
    t_ratio = np.clip(temperature / tc, 1e-6, 0.9999)
    return 1.0 / np.sqrt(1.0 - t_ratio**4)


def tls_dispersion_term(temperature: np.ndarray, f0_hz: float, f_tls: float) -> np.ndarray:
    arg = 0.5 + (PLANCK * f0_hz) / (2.0 * np.pi * 1j * LOSS_BOLTZMANN * temperature)
    psi = digamma(arg)
    real_part = np.real(psi)
    log_term = np.log((PLANCK * f0_hz) / (LOSS_BOLTZMANN * temperature))
    return (f_tls / np.pi) * (real_part - log_term)


def kinetic_shift_model(
    temperature: np.ndarray,
    f0_hz: float,
    alpha: float,
    tc: float,
    f_tls: float,
    mode: str,
) -> np.ndarray:
    mb_term = -0.5 * alpha * (mb_sigma_ratio(temperature, tc) - 1.0)
    tls_term = tls_dispersion_term(temperature, f0_hz, f_tls)
    if mode == "MB":
        return f0_hz * (1.0 + mb_term)
    if mode == "TLS":
        return f0_hz * (1.0 + tls_term)
    return f0_hz * (1.0 + mb_term + tls_term)


def fit_kinetic(
    df: pd.DataFrame,
    tc_kelvin: float,
    alpha_init: float,
    mode: str,
    f_tls_init: float,
) -> Tuple[np.ndarray, np.ndarray]:
    temperature = df["temperature"].to_numpy()
    fr_hz = df["fr"].to_numpy()
    initial = [fr_hz.max(), alpha_init, tc_kelvin, f_tls_init]

    def model(temp: np.ndarray, f0: float, alpha: float, tc: float, f_tls: float) -> np.ndarray:
        return kinetic_shift_model(temp, f0, alpha, tc, f_tls, mode)

    lower = [0.0, 0.0, max(temperature.min() * 0.5, 0.1), -1.0]
    upper = [np.inf, 5.0, max(temperature.max() * 5.0, tc_kelvin * 5.0), 1.0]

    if mode == "MB":
        initial = [fr_hz.max(), alpha_init, tc_kelvin]
        lower = [0.0, 0.0, max(temperature.min() * 0.5, 0.1)]
        upper = [np.inf, 5.0, max(temperature.max() * 5.0, tc_kelvin * 5.0)]

        def model(temp: np.ndarray, f0: float, alpha: float, tc: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, alpha, tc, 0.0, "MB")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    if mode == "TLS":
        initial = [fr_hz.max(), f_tls_init]
        lower = [0.0, -1.0]
        upper = [np.inf, 1.0]

        def model(temp: np.ndarray, f0: float, f_tls: float) -> np.ndarray:
            return kinetic_shift_model(temp, f0, 0.0, tc_kelvin, f_tls, "TLS")

        params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
        return params, covariance

    params, covariance = curve_fit(model, temperature, fr_hz, p0=initial, bounds=(lower, upper), maxfev=10000)
    return params, covariance


